integrator                 = md
dt                         = 0.001
nsteps                     = 100000
nstlog                     = 10
rlist                      = 1.0
coulombtype                = Cut-off
rcoulomb-switch            = 0
rcoulomb                   = 1.0
epsilon-r                  = 1
epsilon-rf                 = 1
vdw-type                   = Cut-off
rvdw-switch                = 0
rvdw                       = 1.0
DispCorr                   = no
Tcoupl                     = no
Pcoupl                     = no

ramd-active                = yes
ramd-seed                  = 1234
ramd-eval-freq             = 10
ramd-out-freq              = 10
ramd-old-angle-dist        = no
ramd-groups-file           = 4water_ramd_groups.in
